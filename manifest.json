{
    "manifest_version": 3, 
    "name": "My Extension",
    "version": "1.0",
    "action": {
        "default_popup": "popup.html"
    },
    "description": "A simple Chrome extension",
    "host_permissions": [
        "https://api.groq.com/*"
    ],
    "content_scripts": [
        {
            "matches": ["https://leetcode.com/*"],
            "js": ["prompt.js", "content.js", "config.js"],
            "css": ["content.css"]
        }
    ]
   
}
